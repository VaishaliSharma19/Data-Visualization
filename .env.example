# Provider selection: scraperapi | scrapingbee
PROVIDER=scraperapi
# Provider mode: proxy (recommended with ScraperAPI) or api (URL wrapping)
PROVIDER_MODE=proxy

# ScraperAPI
SCRAPERAPI_KEY=your_scraperapi_key
# Optional flags
SCRAPERAPI_PREMIUM=1
SCRAPERAPI_ULTRA_PREMIUM=0
SCRAPER_SESSION=123456
COUNTRY_CODE=us

# ScrapingBee (if using)
SCRAPINGBEE_KEY=your_scrapingbee_key

# Playwright-level proxy (not the provider) e.g. http://user:pass@host:port
# PLAYWRIGHT_PROXY=

# Tuning
HEADLESS=0
CONCURRENCY=1
LOAD_TIMEOUT_MS=90000
STEP_SLEEP_MIN=1.5
STEP_SLEEP_MAX=2.5
NAV_SLEEP_MIN=4.5
NAV_SLEEP_MAX=9.0

# Output and scope
CATEGORY_URL=https://www.rei.com/c/womens-t-shirts
OUT_CSV=rei_womens_tshirts.csv
MAX_PRODUCTS=90